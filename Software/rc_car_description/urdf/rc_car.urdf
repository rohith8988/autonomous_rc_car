<?xml version="1.0"?>
<!--
  DKS-Basic ESP32 RC Car - Version 1.
  GENERATED by tools/build_urdf.py - edit that, not this file.

  Visuals are the actual printed STLs from Hardware/Mechanical.
  Collision is primitives (fast, stable contacts).
  Frame: REP-103, metres. base_link = mid-wheelbase at axle height.
  MASSES/INERTIAS ARE ESTIMATES, not measured: each link is an
  equivalent box or cylinder, so treat them as a starting point
  and weigh the real car before trusting dynamics results.
    wheelbase 0.258 m   track 0.176 m   wheel r 0.033 m
    steering +/-0.52 rad     final drive 3.0:1 (14T/42T)
-->
<robot name="rc_car">

  <material name="chassis"><color rgba="0.30 0.30 0.32 1.0"/></material>
  <material name="tyre"><color rgba="0.06 0.06 0.06 1.0"/></material>
  <material name="rim"><color rgba="0.85 0.85 0.87 1.0"/></material>
  <material name="steer"><color rgba="0.75 0.15 0.12 1.0"/></material>
  <material name="motor"><color rgba="0.10 0.10 0.12 1.0"/></material>
  <material name="gear"><color rgba="0.90 0.55 0.10 1.0"/></material>
  <material name="servo"><color rgba="0.10 0.35 0.75 1.0"/></material>

  <!-- ===== FRAME: base_footprint (ground) -> base_link (mid-wheelbase, axle height) ===== -->
  <!-- ground-projected frame; spawn at z=0 to rest on the floor.
       Tiny inertial so mass-lumping sims do not default it to 1 kg. -->
  <link name="base_footprint">
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="1.000e-08" ixy="0" ixz="0" iyy="1.000e-08" iyz="0" izz="1.000e-08"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.033"/>
  </joint>

  <!-- chassis: printed tub, bars, front block, rear frame,
       custom X2212 motor mount, body-mount posts and bumper -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.012"/>
      <mass value="0.6"/>
      <inertia ixx="9.000e-04" ixy="0" ixz="0" iyy="4.680e-03" iyz="0" izz="5.220e-03"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.012"/>
      <geometry><box size="0.29 0.118 0.046"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.1915 0 -0.00715"/>
      <geometry><box size="0.025 0.16 0.0099"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.009 0 -0.0201" rpy="0 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Chassis-1.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="0.009 0 -0.0201" rpy="0 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Chassis-2_A.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="0.009 0 -0.0201" rpy="0 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Body_L.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="0.009 0 -0.0201" rpy="0 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Body_R.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="0.009 0 -0.0201" rpy="0 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Front-Bars.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="0.009 0 -0.0201" rpy="0 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Bumper.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="0.009 0 -0.0201" rpy="0 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Rear-Flex-1.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="0.009 0 -0.0201" rpy="0 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Rear-Flex-2.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="0.009 0 -0.0201" rpy="0 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Clamp.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="0.1875 0 -0.1386" rpy="-1.570796 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Front-Case-Holder.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="-0.1405 0 0.1694" rpy="-1.570796 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Clamp-Case-Holder.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="-0.085115 0 -0.137271" rpy="1.047198 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Rear-Case-Holder.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="0.009 0 -0.0181" rpy="0 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Rear-Frame-Lower.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="0.009 0.055 -0.0291" rpy="1.570796 -1.570796 0"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Rear-Frame_L.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="0.009 -0.0392 -0.02907" rpy="-1.570796 1.570796 0"/>
      <geometry><mesh filename="package://rc_car_description/meshes/X2212_Rear_Frame_A_OnePiece.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="0.202563 -0.050319 -0.0196" rpy="0 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Front-Bars-Lower.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="0.135 0 0.13415" rpy="1.570796 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_A_Front-Frame.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
    <visual>
      <origin xyz="0.009 0 -0.0201" rpy="0 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_A_Front-Bars-Upper.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="chassis"/>
    </visual>
  </link>

  <!-- ===== FRONT CORNERS: steering knuckle -> free-rolling wheel ===== -->

  <!-- left steering knuckle, pivoting on the measured
       kingpin at y = +0.070 (NOT the tyre centreline).
       INDEPENDENT: the real tie rod is a closed loop URDF
       cannot express, so the two kingpins are left free and
       the controller supplies the Ackermann split. -->
  <joint name="front_left_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steer_link"/>
    <origin xyz="0.129 0.07 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.52" upper="0.52" effort="2.0" velocity="7.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <link name="front_left_steer_link">
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="2.822e-06" ixy="0" ixz="0" iyy="1.207e-06" iyz="0" izz="2.948e-06"/>
    </inertial>
    <collision>
      <origin xyz="0 0.009 0"/>
      <geometry><box size="0.02 0.03 0.03"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.068406 -0.013001 -0.037902" rpy="1.570796 1.4559 3.141593"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Wheel-Hub_mirrored.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="steer"/>
    </visual>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steer_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0.018 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>
  <link name="front_left_wheel">
    <inertial>
      <mass value="0.035"/>
      <inertia ixx="1.150e-05" ixy="0" ixz="0" iyy="1.906e-05" iyz="0" izz="1.150e-05"/>
    </inertial>
    <collision>
      <origin rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.033" length="0.026"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.013 -0.033 0" rpy="-1.570796 0 0"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Basic-Wheel-01-Tire.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="tyre"/>
    </visual>
    <visual>
      <origin xyz="0.013 -0.0264 0" rpy="-1.570796 0 0"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Basic-Wheel-01-Wheel.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="rim"/>
    </visual>
    <visual>
      <origin xyz="-0.12 -0.088 -0.0201" rpy="0 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Wheel-Axis.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="steer"/>
    </visual>
    <visual>
      <origin xyz="0.12 -0.088 0.0201" rpy="3.141593 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Wheel-Axis.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="steer"/>
    </visual>
    <visual>
      <origin xyz="-0.079563 -0.058497 -0.031663" rpy="-1.570796 0 0"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Wheel-Axis-Nut.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="steer"/>
    </visual>
  </link>

  <!-- right steering knuckle, pivoting on the measured
       kingpin at y = -0.070 (NOT the tyre centreline).
       INDEPENDENT: the real tie rod is a closed loop URDF
       cannot express, so the two kingpins are left free and
       the controller supplies the Ackermann split. -->
  <joint name="front_right_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steer_link"/>
    <origin xyz="0.129 -0.07 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.52" upper="0.52" effort="2.0" velocity="7.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <link name="front_right_steer_link">
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="2.822e-06" ixy="0" ixz="0" iyy="1.207e-06" iyz="0" izz="2.948e-06"/>
    </inertial>
    <collision>
      <origin xyz="0 -0.009 0"/>
      <geometry><box size="0.02 0.03 0.03"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.068406 0.013001 -0.037902" rpy="1.570796 -1.4559 0"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Wheel-Hub.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="steer"/>
    </visual>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steer_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 -0.018 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>
  <link name="front_right_wheel">
    <inertial>
      <mass value="0.035"/>
      <inertia ixx="1.150e-05" ixy="0" ixz="0" iyy="1.906e-05" iyz="0" izz="1.150e-05"/>
    </inertial>
    <collision>
      <origin rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.033" length="0.026"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.013 0.033 0" rpy="-1.570796 0 3.141593"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Basic-Wheel-01-Tire.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="tyre"/>
    </visual>
    <visual>
      <origin xyz="-0.013 0.0264 0" rpy="-1.570796 0 3.141593"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Basic-Wheel-01-Wheel.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="rim"/>
    </visual>
    <visual>
      <origin xyz="-0.12 0.088 -0.0201" rpy="0 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Wheel-Axis_mirrored.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="steer"/>
    </visual>
    <visual>
      <origin xyz="0.12 0.088 0.0201" rpy="3.141593 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Wheel-Axis_mirrored.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="steer"/>
    </visual>
    <visual>
      <origin xyz="0.079563 0.058497 -0.031663" rpy="-1.570796 0 3.141593"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Wheel-Axis-Nut.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="steer"/>
    </visual>
  </link>

  <!-- ===== STEERING LINKAGE: fixed visual decoration =====
       The real servo/horn/tie-rod is a CLOSED loop, which URDF
       cannot express. Modelling it with <mimic> made the servo a
       follower of the wheel it actually drives, and forced both
       kingpins parallel, directly contradicting the Ackermann
       split a steering controller commands. So it is drawn, not
       articulated. The steering DOFs are the two kingpins. -->
  <!-- SV1 TowardPro MG90S (GPIO26). Body + horn are drawn at
       the straight-ahead pose. -->
  <joint name="servo_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="servo_link"/>
    <origin xyz="0.1211 0 -0.0014"/>
  </joint>
  <link name="servo_link">
    <inertial>
      <mass value="0.014"/>
      <inertia ixx="1.554e-06" ixy="0" ixz="0" iyy="1.121e-06" iyz="0" izz="7.801e-07"/>
    </inertial>
    <collision>
      <geometry><box size="0.0122 0.0228 0.0285"/></geometry>
    </collision>
    <visual>
      <geometry><box size="0.0122 0.0228 0.0285"/></geometry>
      <material name="servo"/>
    </visual>
  </link>

  <joint name="servo_horn_joint" type="fixed">
    <parent link="servo_link"/>
    <child link="servo_horn"/>
    <origin xyz="0 0 -0.0008"/>
  </joint>
  <link name="servo_horn">
    <inertial>
      <origin xyz="-0.008 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="5.333e-09" ixy="0" ixz="0" iyy="6.933e-08" iyz="0" izz="6.933e-08"/>
    </inertial>
    <collision>
      <origin xyz="-0.008 0 0"/>
      <geometry><box size="0.02 0.004 0.004"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.008 0 0"/>
      <geometry><box size="0.020 0.004 0.004"/></geometry>
      <material name="steer"/>
    </visual>
  </link>

  <joint name="tie_rod_joint" type="fixed">
    <parent link="base_link"/>
    <child link="steering_tie_rod"/>
    <origin xyz="0.1057 0 -0.0021"/>
  </joint>
  <link name="steering_tie_rod">
    <inertial>
      <mass value="0.006"/>
      <inertia ixx="8.583e-06" ixy="0" ixz="0" iyy="7.400e-08" iyz="0" izz="8.653e-06"/>
    </inertial>
    <collision>
      <geometry><box size="0.012 0.131 0.002"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.09666 0 -0.018" rpy="0 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_A_Steering.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="steer"/>
    </visual>
  </link>

  <!-- ===== DRIVE: rear_axle_joint is the ONE traction DOF =====
       Both rear wheels are bolted to a solid axle, so there is a
       single rear degree of freedom; command this joint. The
       motor and 14T pinion are fixed decoration: a URDF <mimic>
       cannot express gear contact, and the previous one had the
       sign wrong (external gears counter-rotate), so the pinion
       and spur turned through each other. -->
  <!-- M1 SunnySky X2212-13 (GPIO25) in the custom mount. Real
       reduction is 3:1 (14T/42T): motor speed = axle speed x 3. -->
  <joint name="motor_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="motor_link"/>
    <origin xyz="-0.1021 -0.0225 0.0104"/>
  </joint>
  <link name="motor_link">
    <inertial>
      <mass value="0.056"/>
      <inertia ixx="6.306e-06" ixy="0" ixz="0" iyy="5.294e-06" iyz="0" izz="6.306e-06"/>
    </inertial>
    <collision>
      <origin rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.01375" length="0.028"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.01375" length="0.028"/></geometry>
      <material name="motor"/>
    </visual>
  </link>

  <joint name="motor_pinion_joint" type="fixed">
    <parent link="motor_link"/>
    <child link="pinion_link"/>
    <origin xyz="0 -0.0242 0"/>
  </joint>
  <link name="pinion_link">
    <inertial>
      <mass value="0.004"/>
      <inertia ixx="1.359e-07" ixy="0" ixz="0" iyy="1.411e-07" iyz="0" izz="1.359e-07"/>
    </inertial>
    <collision>
      <origin rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.0084" length="0.014"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0.0045 0" rpy="-1.570796 0 3.141593"/>
      <geometry><mesh filename="package://rc_car_description/meshes/X2212_Smooth_Herringbone_Gear_1_14T_M3_Clamp.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="gear"/>
    </visual>
  </link>

  <joint name="rear_axle_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_axle_link"/>
    <origin xyz="-0.1290 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.002"/>
    <!-- THE traction DOF. Command joint velocity here; the
         3:1 reduction to the motor is a controller-side
         constant, not a URDF constraint. -->
  </joint>
  <link name="rear_axle_link">
    <inertial>
      <origin xyz="0 -0.013343 0"/>
      <mass value="0.041999999999999996"/>
      <inertia ixx="1.012e-04" ixy="0" ixz="0" iyy="3.311e-06" iyz="0" izz="1.012e-04"/>
    </inertial>
    <collision>
      <origin rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.0064" length="0.171"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 -0.0467 0" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.0212" length="0.015"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.00514 0 0.138" rpy="-1.570796 0 1.570796"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Rear-Axis.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="steer"/>
    </visual>
    <visual>
      <origin xyz="0 -0.0542 0" rpy="-1.570796 0 0"/>
      <geometry><mesh filename="package://rc_car_description/meshes/X2212_Smooth_Herringbone_Gear_2_42T.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="gear"/>
    </visual>
  </link>

  <joint name="rear_left_wheel_joint" type="fixed">
    <parent link="rear_axle_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="0 0.088 0"/>
  </joint>
  <link name="rear_left_wheel">
    <inertial>
      <mass value="0.035"/>
      <inertia ixx="1.150e-05" ixy="0" ixz="0" iyy="1.906e-05" iyz="0" izz="1.150e-05"/>
    </inertial>
    <collision>
      <origin rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.033" length="0.026"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.013 -0.033 0" rpy="-1.570796 0 0"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Basic-Wheel-01-Tire.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="tyre"/>
    </visual>
    <visual>
      <origin xyz="0.013 -0.0264 0" rpy="-1.570796 0 0"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Basic-Wheel-01-Wheel.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="rim"/>
    </visual>
  </link>

  <joint name="rear_right_wheel_joint" type="fixed">
    <parent link="rear_axle_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="0 -0.088 0"/>
  </joint>
  <link name="rear_right_wheel">
    <inertial>
      <mass value="0.035"/>
      <inertia ixx="1.150e-05" ixy="0" ixz="0" iyy="1.906e-05" iyz="0" izz="1.150e-05"/>
    </inertial>
    <collision>
      <origin rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.033" length="0.026"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.013 0.033 0" rpy="-1.570796 0 3.141593"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Basic-Wheel-01-Tire.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="tyre"/>
    </visual>
    <visual>
      <origin xyz="-0.013 0.0264 0" rpy="-1.570796 0 3.141593"/>
      <geometry><mesh filename="package://rc_car_description/meshes/DKS-Basic_DukeDoks_Basic-Wheel-01-Wheel.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="rim"/>
    </visual>
  </link>

  <!-- ============ Gazebo (gz sim Harmonic/Garden) ============
       Fortress: gz-sim-* -> ignition-gazebo-*,
       gz::sim::systems -> ignition::gazebo::systems -->
  <!-- Contact/friction below are UNTUNED starting values, not
       measured: mu is isotropic (mu1 == mu2), which does not
       model a tyre's different longitudinal vs lateral grip.
       Calibrate against the real car before trusting handling. -->
  <gazebo reference="base_link"><mu1>0.2</mu1><mu2>0.2</mu2></gazebo>
  <gazebo reference="front_left_wheel"><mu1>1.2</mu1><mu2>1.2</mu2><kp>1e6</kp><kd>100</kd></gazebo>
  <gazebo reference="front_right_wheel"><mu1>1.2</mu1><mu2>1.2</mu2><kp>1e6</kp><kd>100</kd></gazebo>
  <gazebo reference="rear_left_wheel"><mu1>1.4</mu1><mu2>1.4</mu2><kp>1e6</kp><kd>100</kd></gazebo>
  <gazebo reference="rear_right_wheel"><mu1>1.4</mu1><mu2>1.4</mu2><kp>1e6</kp><kd>100</kd></gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <!-- ONE odometry source. This is simulator ground truth;
           the controller publishes its own wheel-integrated
           estimate on /odom, so keep them on separate topics or
           they interleave two different quantities. -->
      <odom_topic>odom_ground_truth</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- ============ ros2_control ============
       Three real DOFs: one traction + two independent steer.
       /cmd_vel -> per-joint commands is the controller's job
       (config/controllers.yaml), not a plugin workaround. -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="rear_axle_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_left_steer_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_steer_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_left_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find rc_car_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
